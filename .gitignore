node_modules/
dist/
coverage/
# `coverage/` above targets test-coverage output; don't let it swallow the app source
# directory of the same name (Floating-SE Territory page lives here).
!apps/admin/src/pages/coverage/
.turbo/
apps/backend/dist/
packages/shared/dist/
# TS incremental build cache — churns on every build, must not be tracked (#114 §8)
*.tsbuildinfo
apps/mobile/.expo/
package-lock.json


.env
.env.*
!.env.example

*.log

# Docs are now VERSIONED for disaster-recovery (#115): the PRD, business workflow, audits,
# architecture docs, ADRs, UI reference imagery, progress/handoff reports, and SYSTEM-STATE
# live only on one disk otherwise. Policy: track the whole docs/ tree. Secrets stay out via
# the `.env` rules above (they match at any depth); no credentials live under docs/.
.scratch/*
!.scratch/fsm-platform-v1/
.claude/
# Repo-root artifact dirs only — anchored with a leading `/` so they no longer shadow source
# paths that happen to be named `data`/`backups` (e.g. apps/admin/src/components/data/, #114).
/data/
/backups/

.vscode/
.idea/
.DS_Store
Thumbs.db
apps/backend/src/generated/

# #218c — the live-batch stand-down export (`--export-standdown` on the departure dry-run) regenerates
# on every read-only rehearsal and holds real production ticket/device/vehicle rows. Deliberately never
# staged; ignored explicitly so a future `git add -A` cannot sweep it in. The rest of
# `audit/autoplant-reconciliation/` (reports, plans, the Excel benchmark) is tracked on purpose.
audit/autoplant-reconciliation/standdown-live-batches.csv
